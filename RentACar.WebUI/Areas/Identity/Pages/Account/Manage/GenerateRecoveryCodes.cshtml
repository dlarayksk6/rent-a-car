@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "İki faktörlü kimlik doğrulama (2FA) kurtarma kodları oluştur";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}
<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Bu kodları güvenli bir yere saklayın.</strong>
    </p>
    <p>
        Cihazınızı kaybederseniz ve kurtarma kodlarınız yoksa hesabınıza erişiminizi kaybedersiniz.
    </p>
    <p>
        Yeni kurtarma kodları oluşturmak, kimlik doğrulayıcı uygulamalarında kullanılan anahtarları değiştirmez.
        Kimlik doğrulayıcı uygulamasında kullanılan anahtarı değiştirmek istiyorsanız
        <a asp-page="./ResetAuthenticator">kimlik doğrulayıcı anahtarlarınızı sıfırlamalısınız.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Kurtarma Kodları Oluştur</button>
    </form>
</div>