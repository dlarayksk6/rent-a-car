@model RentACar.Entities.SiteContact
@{
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.Title = "İletişim";
}

<div class="no-bottom no-top" id="content">
    <div id="top"></div>


    <section id="subheader" class="jarallax text-light">
        <img src="/quarter/images/background/subheader.jpg" class="jarallax-img" alt="">
        <div class="center-y relative text-center">
            <div class="container">
                <h1>İletişim</h1>
                <p>Bizimle iletişime geçin, size yardımcı olalım.</p>
            </div>
        </div>
    </section>

   
    <section class="pt-5 pb-0">
        <div class="container">
            <div class="row justify-content-center">

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="contact-card text-center">
                        <div class="contact-icon">
                            <i class="fa fa-map-marker"></i>
                        </div>
                        <h5>Adresimiz</h5>
                        <p>@Model.Address</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="contact-card text-center">
                        <div class="contact-icon">
                            <i class="fa fa-phone"></i>
                        </div>
                        <h5>Telefon</h5>
                        <p><a href="tel:@Model.Phone">@Model.Phone</a></p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="contact-card text-center">
                        <div class="contact-icon">
                            <i class="fa fa-envelope"></i>
                        </div>
                        <h5>E-posta</h5>
                        <p><a href="mailto:@Model.Email">@Model.Email</a></p>
                    </div>
                </div>

            </div>
        </div>
    </section>

 
    <section class="pt-4 pb-5">
        <div class="container">
            <div class="text-center mb-4">
                <h2>Konumumuz</h2>
                <div style="width:60px; height:3px; background:#e74c3c; margin:10px auto 0;"></div>
                <p class="text-muted mt-3">Trabzon ofisimize harita üzerinden kolayca ulaşabilirsiniz.</p>
            </div>
            <div style="border-radius:16px; overflow:hidden; box-shadow:0 8px 30px rgba(0,0,0,0.12);">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12210.819299264787!2d39.71520645!3d41.00269615!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40643d4c2740de0b%3A0x73813439c9d4e3c2!2sTrabzon!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str"
                        width="100%" height="450" style="border:0; display:block;"
                        allowfullscreen="" loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </section>

</div>

<style>
    .contact-card {
        background: #fff;
        border-radius: 16px;
        padding: 40px 30px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
        height: 100%;
    }

        .contact-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        }

    .contact-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #179510, #179510);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

        .contact-icon i {
            font-size: 28px;
            color: white;
        }

    .contact-card h5 {
        font-weight: 700;
        font-size: 16px;
        color: #1a1a2e;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .contact-card p {
        color: #666;
        margin: 0;
        font-size: 15px;
        line-height: 1.6;
    }

    .contact-card a {
        color: black;
        text-decoration: none;
    }

        .contact-card a:hover {
            text-decoration: underline;
        }
</style>