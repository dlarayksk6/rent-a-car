@model List<RentACar.Entities.Campaign>
@{
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.Title = "Kampanyalar";
    var active = Model.Where(c => c.IsActive).ToList();
    var passive = Model.Where(c => !c.IsActive).ToList();
}

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <section id="subheader" class="jarallax text-light">
        <img src="/quarter/images/background/subheader.jpg" class="jarallax-img" alt="">
        <div class="center-y relative text-center">
            <div class="container">
                <h1>Kampanyalar</h1>
                <p>Özel fırsatları kaçırmayın.</p>
            </div>
        </div>
    </section>


    <section class="pt-5 pb-3">
        <div class="container">
            <div class="text-center mb-5">
                <h2>Güncel Kampanyalar</h2>
                <div style="width:60px; height:3px; background:#e74c3c; margin:10px auto;"></div>
            </div>

            @if (active.Any())
            {
                <div class="row">
                    @foreach (var c in active)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="campaign-card active-card">
                                @if (!string.IsNullOrEmpty(c.ImageUrl))
                                {
                                    <div class="campaign-img">
                                        <img src="@c.ImageUrl" alt="@c.Title" />
                                        <div class="campaign-badge">Aktif</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="campaign-no-img">
                                        <i class="fa fa-bullhorn"></i>
                                        <div class="campaign-badge">Aktif</div>
                                    </div>
                                }
                                <div class="campaign-body">
                                    <h4>@c.Title</h4>
                                    @if (!string.IsNullOrEmpty(c.Description))
                                    {
                                        <p>@c.Description</p>
                                    }
                                    <small class="campaign-date">
                                        <i class="fa fa-calendar"></i> @c.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center" style="padding:40px; color:#aaa;">
                    <i class="fa fa-bullhorn" style="font-size:50px;"></i>
                    <h4 style="margin-top:15px;">Şu an aktif kampanya bulunmuyor.</h4>
                    <p>Yakında yeni kampanyalar için takipte kalın!</p>
                </div>
            }
        </div>
    </section>

   
    @if (passive.Any())
    {
        <section class="pt-3 pb-5" style="background:#f8f9fa;">
            <div class="container">
                <div class="text-center mb-4">
                    <h3 style="color:#999;">Geçmiş Kampanyalar</h3>
                    <div style="width:40px; height:2px; background:#ccc; margin:8px auto;"></div>
                    <small class="text-muted">Bu kampanyalar sona ermiştir.</small>
                </div>
                <div class="row">
                    @foreach (var c in passive)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="campaign-card passive-card">
                                @if (!string.IsNullOrEmpty(c.ImageUrl))
                                {
                                    <div class="campaign-img">
                                        <img src="@c.ImageUrl" alt="@c.Title" style="filter:grayscale(60%);" />
                                        <div class="campaign-badge" style="background:#999;">Sona Erdi</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="campaign-no-img" style="background:#eee;">
                                        <i class="fa fa-bullhorn" style="color:#bbb;"></i>
                                        <div class="campaign-badge" style="background:#999;">Sona Erdi</div>
                                    </div>
                                }
                                <div class="campaign-body" style="opacity:0.7;">
                                    <h4>@c.Title</h4>
                                    @if (!string.IsNullOrEmpty(c.Description))
                                    {
                                        <p>@c.Description</p>
                                    }
                                    <small class="campaign-date">
                                        <i class="fa fa-calendar"></i> @c.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

</div>

<style>
    .campaign-card {
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        background: #fff;
        transition: transform 0.3s, box-shadow 0.3s;
        height: 100%;
    }

    .active-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.12);
    }

    .campaign-img {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

        .campaign-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s;
        }

    .active-card:hover .campaign-img img {
        transform: scale(1.05);
    }

    .campaign-no-img {
        position: relative;
        height: 200px;
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .campaign-no-img i {
            font-size: 60px;
            color: rgba(255,255,255,0.6);
        }

    .campaign-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #e74c3c;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .campaign-body {
        padding: 20px;
    }

        .campaign-body h4 {
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 10px;
            font-size: 17px;
        }

        .campaign-body p {
            color: #666;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 12px;
        }

    .campaign-date {
        color: #aaa;
        font-size: 12px;
    }
</style>