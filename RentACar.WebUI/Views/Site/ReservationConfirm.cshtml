@{
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.Title = "Rezervasyon Tamamlandı";
}

<div class="no-bottom no-top zebra" id="content">
    <div id="top"></div>

    <section id="subheader" class="jarallax text-light">
        <img src="/quarter/images/background/subheader.jpg" class="jarallax-img" alt="">
        <div class="center-y relative text-center">
            <div class="container">
                <h1>Rezervasyon Tamamlandı</h1>
            </div>
        </div>
    </section>

    <section class="pt-5 pb-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center">
                    <div class="de-box" style="padding:40px;">
                        <i class="fa fa-check-circle" style="font-size:80px; color:#2ecc71;"></i>
                        <div class="spacer-20"></div>
                        <h3>Rezervasyonunuz Alındı!</h3>
                        <p>Rezervasyonunuz başarıyla oluşturuldu. En kısa sürede sizinle iletişime geçeceğiz.</p>
                        <div class="spacer-20"></div>
                        <a href="/Site/Cars" class="btn-main">Araçlara Dön</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>