@model List<RentACar.DTOs.Blog.BlogListDto>
@inject IPermissionService PermissionService

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var p = await PermissionService.GetCurrentUserPermissionsAsync();
}

<section class="content-header">
    <h1>Blog Yönetimi</h1>

    @if (p.Contains("Blog.Manage") || User.IsInRole("Admin"))
    {
        <a href="/Blog/Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Yeni Blog Ekle
        </a>
    }

</section>

<section class="content">

 

    <div class="box">
        <div class="box-body">

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Resim</th>
                        <th>Başlık</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(b.ImageUrl))
                                {
                                    <img src="@b.ImageUrl" style="width:70px;height:50px;object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">Yok</span>
                                }
                            </td>

                            <td>@b.Title</td>

                            <td>
                                @if (b.IsApproved)
                                {
                                    <span class="label label-success">Onaylı</span>
                                }
                                else
                                {
                                    <span class="label label-warning">Bekliyor</span>
                                }
                            </td>

                            <td>@b.CreatedAt.ToString("dd.MM.yyyy")</td>

                            <td>
                                <a href="/Blog/Details/@b.BlogPostId" class="btn btn-info btn-sm">
                                    <i class="fa fa-eye"></i> Gör
                                </a>

                                @if (p.Contains("Blog.Manage"))
                                {
                                    <a href="/Blog/Edit/@b.BlogPostId" class="btn btn-warning btn-sm">
                                        <i class="fa fa-edit"></i> Düzenle
                                    </a>
                                }
                              

                                @if (!b.IsApproved && p.Contains("Blog.Approve"))
                                {
                                    <form asp-action="Approve" asp-controller="Blog" asp-route-id="@b.BlogPostId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="fa fa-check"></i> Onayla
                                        </button>
                                    </form>

                                }


                                @if (p.Contains("Blog.Delete"))
                                {
                                    <form method="post" action="/Blog/Delete/@b.BlogPostId" style="display:inline;"
                                          onsubmit="return confirm('Bu blog yazısını silmek istediğinize emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i> Sil
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</section>
