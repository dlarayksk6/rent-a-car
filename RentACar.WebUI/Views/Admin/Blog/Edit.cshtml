@model RentACar.DTOs.Blog.BlogUpdateDto
@inject IPermissionService PermissionService

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>Blog Düzenle</h1>
</section>

<section class="content">

    <div class="box box-primary">
        <div class="box-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="BlogPostId" />

                <div class="form-group">
                    <label>Başlık</label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>İçerik</label>
                    <textarea asp-for="Content" class="form-control" rows="8" required></textarea>
                </div>

                <div class="form-group">
                    <label>Mevcut Görsel</label><br />

                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                    {
                        <img src="@Model.ExistingImageUrl" width="150" style="margin-bottom:10px; border-radius:4px;" />
                    }
                    else
                    {
                        <p class="text-muted">Görsel Yok</p>
                    }
                </div>

                <div class="form-group">
                    <label>Yeni Görsel (İsteğe bağlı)</label>
                    <input type="file" name="image" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Kaydet
                </button>

                <a href="/Blog" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Geri Dön
                </a>

            </form>

        </div>
    </div>

</section>
