@model List<RentACar.Entities.Location>
@inject IPermissionService PermissionService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lokasyon Yönetimi";
    var p = await PermissionService.GetCurrentUserPermissionsAsync();
}

<section class="content-header">
    <h1><i class="fa fa-map-marker"></i> Lokasyon Yönetimi</h1>
    <ol class="breadcrumb">
        <li><a href="/Home"><i class="fa fa-home"></i> Ana Sayfa</a></li>
        <li class="active">Lokasyon Yönetimi</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        @if (p.Contains("Locations.Manage") || User.IsInRole("Admin"))
        {
            <div class="col-md-4">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title"><i class="fa fa-plus"></i> Yeni Lokasyon Ekle</h3>
                    </div>
                    <div class="box-body">
                        <form method="post" action="/Locations/Create">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label>Lokasyon Adı <span class="text-danger">*</span></label>
                                <input type="text" name="Name" class="form-control" placeholder="Örn: İstanbul Havalimanı" required>
                            </div>
                            <div class="form-group">
                                <label>Adres</label>
                                <textarea name="Address" class="form-control" rows="2" placeholder="Adres bilgisi..."></textarea>
                            </div>
                            <div class="form-group">
                                <label>
                                    <input type="checkbox" name="IsPickup" value="true" checked> Alış Noktası
                                </label>
                            </div>
                            <div class="form-group">
                                <label>
                                    <input type="checkbox" name="IsDropoff" value="true" checked> Bırakış Noktası
                                </label>
                            </div>
                            <div class="form-group">
                                <label>
                                    <input type="checkbox" name="IsActive" value="true" checked> Aktif
                                </label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fa fa-save"></i> Kaydet
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        <div class="@(p.Contains("Locations.Manage") || User.IsInRole("Admin") ? "col-md-8" : "col-md-12")">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-list"></i> Lokasyonlar (@Model.Count)</h3>
                </div>
                <div class="box-body no-padding">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th style="width:60px;">#</th>
                                <th>Lokasyon Adı</th>
                                <th>Adres</th>
                                <th style="width:70px; text-align:center;">Alış</th>
                                <th style="width:70px; text-align:center;">Bırakış</th>
                                <th style="width:80px;">Durum</th>
                                <th style="width:120px; text-align:right;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted" style="padding:30px;">
                                        <i class="fa fa-inbox fa-2x"></i><br>Henüz lokasyon eklenmemiş.
                                    </td>
                                </tr>
                            }
                            @foreach (var loc in Model)
                            {
                                <tr>
                                    <td>@loc.LocationId</td>
                                    <td><strong>@loc.Name</strong></td>
                                    <td><small class="text-muted">@loc.Address</small></td>
                                    <td style="text-align:center;">
                                        @if (loc.IsPickup)
                                        {
                                            <span class="label label-success"><i class="fa fa-check"></i></span>
                                        }
                                        else
                                        {
                                            <span class="label label-default"><i class="fa fa-times"></i></span>
                                        }
                                    </td>
                                    <td style="text-align:center;">
                                        @if (loc.IsDropoff)
                                        {
                                            <span class="label label-success"><i class="fa fa-check"></i></span>
                                        }
                                        else
                                        {
                                            <span class="label label-default"><i class="fa fa-times"></i></span>
                                        }
                                    </td>
                                    <td>
                                        <span class="location-status-badge label @(loc.IsActive ? "label-success" : "label-danger")"
                                              data-id="@loc.LocationId" style="cursor:pointer; font-size:12px;" title="Durumu değiştir">
                                            @(loc.IsActive ? "Aktif" : "Pasif")
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        @if (p.Contains("Locations.Manage") || User.IsInRole("Admin"))
                                        {
                                            <button class="btn btn-xs btn-warning edit-location-btn"
                                                    data-id="@loc.LocationId"
                                                    data-name="@loc.Name"
                                                    data-address="@loc.Address"
                                                    data-ispickup="@loc.IsPickup.ToString().ToLower()"
                                                    data-isdropoff="@loc.IsDropoff.ToString().ToLower()"
                                                    data-active="@loc.IsActive.ToString().ToLower()"
                                                    title="Düzenle">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                        }
                                        @if (p.Contains("Locations.Delete") || User.IsInRole("Admin"))
                                        {
                                            <form method="post" action="/Locations/Delete" style="display:inline;"
                                                  onsubmit="return confirm('@loc.Name lokasyonunu silmek istediğinizden emin misiniz?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@loc.LocationId" />
                                                <button type="submit" class="btn btn-xs btn-danger" title="Sil">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-edit"></i> Lokasyon Düzenle</h4>
            </div>
            <form method="post" action="/Locations/Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="LocationId" id="editLocationId">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Lokasyon Adı <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Adres</label>
                        <textarea name="Address" id="editAddress" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="IsPickup" id="editIsPickup" value="true"> Alış Noktası
                        </label>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="IsDropoff" id="editIsDropoff" value="true"> Bırakış Noktası
                        </label>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="IsActive" id="editIsActive" value="true"> Aktif
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-save"></i> Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(".edit-location-btn").on("click", function () {
            var id = $(this).data("id");
            var name = $(this).data("name");
            var address = $(this).data("address");
            var isPickup = $(this).data("ispickup") === "true";
            var isDropoff = $(this).data("isdropoff") === "true";
            var active = $(this).data("active") === "true";

            $("#editLocationId").val(id);
            $("#editName").val(name);
            $("#editAddress").val(address);
            $("#editIsPickup").prop("checked", isPickup);
            $("#editIsDropoff").prop("checked", isDropoff);
            $("#editIsActive").prop("checked", active);

            $("#editModal").modal("show");
        });

        $(".location-status-badge").on("click", function () {
            var id = $(this).data("id");
            var badge = $(this);
            $.post("/Locations/ToggleStatus", { id: id }, function () {
                var isActive = badge.hasClass("label-success");
                badge.toggleClass("label-success label-danger");
                badge.text(isActive ? "Pasif" : "Aktif");
            });
        });
    </script>
}
