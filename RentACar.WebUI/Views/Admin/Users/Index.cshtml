@model List<RentACar.DTOs.User.UserListDto>
@inject IPermissionService PermissionService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var p = await PermissionService.GetCurrentUserPermissionsAsync();
}
<section class="content-header">
    <h1>Kullanıcı Yönetimi</h1>
</section>
<section class="content">
    @if (p.Contains("Users.Manage"))
    {
        <a href="/AdminUsers/CreateUser" class="btn btn-primary">
            <i class="fa fa-plus"></i> Yeni Kullanıcı Ekle
        </a>
    }
    else
    {
        <button class="btn btn-primary" disabled>Yeni Kullanıcı Ekle</button>
    }
    <br /><br />
    <div class="box">
        <div class="box-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Roller</th>
                        <th>Yetkiler</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isAdmin = item.Roles.Contains("Admin");
                        <tr>
                            <td>@item.Email</td>
                            <td>@string.Join(", ", item.Roles)</td>
                            <td>
                                @{
                                    var permGroups = item.Permissions
                                    .Select(p2 => p2.Contains(".") ? p2.Split('.')[0] : p2)
                                    .Distinct()
                                    .ToList();
                                }
                                @if (item.Permissions.Count == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span data-toggle="tooltip" data-placement="top"
                                          title="@string.Join(", ", item.Permissions)"
                                          style="cursor:pointer;">
                                        @foreach (var group in permGroups)
                                        {
                                            <span class="label label-info" style="margin-right:3px;">@group</span>
                                        }
                                        <small class="text-muted">(@item.Permissions.Count)</small>
                                    </span>
                                }
                            </td>
                            <td>
                                @if (p.Contains("Users.Manage"))
                                {
                                    <a href="@Url.Action("EditUser", new { id = item.Id })"
                                       class="btn btn-sm btn-warning">
                                        <i class="fa fa-edit"></i> Düzenle
                                    </a>
                                }
                                @if (!isAdmin && p.Contains("Users.Manage"))
                                {
                                    <form method="post" action="@Url.Action("DeleteUser")" style="display:inline;"
                                          onsubmit="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i> Sil
                                        </button>
                                    </form>
                                }
                                else if (isAdmin)
                                {
                                    <button class="btn btn-sm btn-default" disabled>
                                        <i class="fa fa-lock"></i> Admin – Silinemez
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
    $(function() {
        $('[data-toggle="tooltip"]').tooltip({
            html: true,
            placement: 'top',
            template: '<div class="tooltip" role="tooltip"><div class="tooltip-arrow"></div><div class="tooltip-inner" style="max-width:400px; text-align:left;"></div></div>'
        });
    });
</script>