@model List<RentACar.DTOs.Reservation.ReservationListDto>
@inject IPermissionService PermissionService

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Rezervasyon Yönetimi";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var statuses = ViewBag.Statuses as List<string>;
    var userPermissions = await PermissionService.GetCurrentUserPermissionsAsync();
    var aylikGelir = Model.Where(r => r.Status == "Tamamlandı" && r.CreatedAt.Month == DateTime.Now.Month && r.CreatedAt.Year == DateTime.Now.Year).Sum(r => r.TotalPrice);
}

<section class="content-header">
    <h1>Rezervasyon Yönetimi <small>Tüm rezervasyonlar</small></h1>
</section>

<section class="content">

    <div class="row">
        <div class="col-md-2 col-sm-4 col-xs-6">
            <div class="info-box bg-yellow">
                <span class="info-box-icon"><i class="fa fa-clock-o"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Beklemede</span>
                    <span class="info-box-number">@Model.Count(r => r.Status == "Beklemede")</span>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-xs-6">
            <div class="info-box bg-green">
                <span class="info-box-icon"><i class="fa fa-check"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Onaylı</span>
                    <span class="info-box-number">@Model.Count(r => r.Status == "Onaylı")</span>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-xs-6">
            <div class="info-box bg-light-blue">
                <span class="info-box-icon"><i class="fa fa-credit-card"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Kapora</span>
                    <span class="info-box-number">@Model.Count(r => r.Status == "Kapora Alındı")</span>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-xs-6">
            <div class="info-box bg-blue">
                <span class="info-box-icon"><i class="fa fa-money"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Ödendi</span>
                    <span class="info-box-number">@Model.Count(r => r.Status == "Ödendi")</span>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-xs-6">
            <div class="info-box" style="background:#1abc9c;">
                <span class="info-box-icon"><i class="fa fa-flag-checkered"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Tamamlandı</span>
                    <span class="info-box-number">@Model.Count(r => r.Status == "Tamamlandı")</span>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-xs-6">
            <div class="info-box bg-red">
                <span class="info-box-icon"><i class="fa fa-ban"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">İptal</span>
                    <span class="info-box-number">@Model.Count(r => r.Status == "İptal")</span>
                </div>
            </div>
        </div>
    </div>

  
    <div class="callout callout-success">
        <h4><i class="fa fa-line-chart"></i> Bu Ayın Geliri: <strong>@aylikGelir.ToString("N0") ₺</strong></h4>
    </div>

    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title"><i class="fa fa-list"></i> Rezervasyon Listesi</h3>
        </div>
        <div class="box-body">

      
            <form method="get" class="form-inline" style="margin-bottom:15px;">
                <div class="form-group">
                    <input type="text" name="search" value="@search"
                           placeholder="Müşteri adı, TC, plaka..."
                           class="form-control" style="width:280px;" />
                </div>
                &nbsp;
                <div class="form-group">
                    <select name="status" class="form-control">
                        <option value="">Tüm Durumlar</option>
                        @foreach (var s in statuses ?? new List<string>())
                        {
                            <option value="@s" selected="@(s == status ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>
                &nbsp;
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-search"></i> Filtrele
                </button>
                <a href="@Url.Action("Index")" class="btn btn-default">
                    <i class="fa fa-refresh"></i> Temizle
                </a>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped">
                    <thead>
                        <tr class="bg-light-blue">
                            <th width="50">#</th>
                            <th>Müşteri</th>
                            <th>Araç</th>
                            <th>Tarih</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                            <th width="130">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var res in Model)
                            {
                                var badge = res.Status == "Onaylı" ? "success" :
                                res.Status == "Beklemede" ? "warning" :
                                res.Status == "Tamamlandı" ? "primary" :
                                res.Status == "Kapora Alındı" ? "info" :
                                res.Status == "Ödendi" ? "primary" :
                                res.Status == "İptal" ? "danger" : "default";

                                <tr>
                                    <td><strong>@res.ReservationId</strong></td>
                                    <td>
                                        <strong>@res.FullName</strong><br />
                                        <small class="text-muted">@res.PhoneNumber</small>
                                    </td>
                                    <td>
                                        <strong>@res.CarBrand @res.CarModel</strong><br />
                                        <small class="text-muted">@res.PlateNumber</small>
                                    </td>
                                    <td>
                                        <i class="fa fa-calendar text-blue"></i> @res.StartDate.ToString("dd.MM.yyyy")<br />
                                        <i class="fa fa-calendar-check-o text-red"></i> <small>@res.EndDate.ToString("dd.MM.yyyy")</small><br />
                                        <span class="label label-default">@((res.EndDate - res.StartDate).Days + 1) gün</span>
                                    </td>
                                    <td><strong class="text-success">@res.TotalPrice.ToString("N0") ₺</strong></td>
                                    <td>
                                        <span class="label label-@badge">@res.Status</span>
                                        @if (res.IsAdminBlocked)
                                        {
                                            <br />
                                
                                            <span class="label label-danger">Admin Bloke</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group-vertical btn-group-xs">
                                            @if (userPermissions.Contains("Reservations.View") || User.IsInRole("Admin"))
                                            {
                                                <a href="/Reservations/Details/@res.ReservationId" class="btn btn-info btn-xs">
                                                    <i class="fa fa-eye"></i> Detay
                                                </a>
                                                <a href="/Reservations/Calendar?carId=@res.CarId" class="btn btn-primary btn-xs">
                                                    <i class="fa fa-calendar"></i> Takvim
                                                </a>
                                            }
                                            @if ((userPermissions.Contains("Reservations.Cancel") || User.IsInRole("Admin")) && res.Status != "İptal")
                                            {
                                                <button onclick="cancelRes(@res.ReservationId)" class="btn btn-warning btn-xs">
                                                    <i class="fa fa-ban"></i> İptal
                                                </button>
                                            }
                                            @if (userPermissions.Contains("Reservations.Delete") || User.IsInRole("Admin"))
                                            {
                                                <button onclick="deleteRes(@res.ReservationId)" class="btn btn-danger btn-xs">
                                                    <i class="fa fa-trash"></i> Sil
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted" style="padding:30px;">
                                    <i class="fa fa-inbox fa-2x"></i><br />Rezervasyon bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function cancelRes(id) {
            if (confirm('Bu rezervasyonu iptal etmek istediğinize emin misiniz?')) {
                $.post('/Reservations/Cancel', { id: id }, function() { location.reload(); });
            }
        }
        function deleteRes(id) {
            if (confirm('Kalıcı olarak silinsin mi? Bu işlem geri alınamaz!')) {
                $.post('/Reservations/Delete', { id: id }, function() { location.reload(); });
            }
        }
    </script>
}