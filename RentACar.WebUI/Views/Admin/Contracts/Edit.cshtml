@model RentACar.Entities.ContractDocument
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Sözleşme Düzenle";
}

<section class="content-header">
    <h1><i class="fa fa-edit"></i> Sözleşme Düzenle</h1>
</section>

<section class="content">
    <div class="box box-primary">
        <div class="box-body">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ContractId" value="@Model.ContractId" />
                <input type="hidden" name="PdfUrl" value="@Model.PdfUrl" />

                <div class="form-group">
                    <label>Başlık <span class="text-danger">*</span></label>
                    <input name="Title" class="form-control" value="@Model.Title" required />
                </div>

                <div class="form-group">
                    <label>Sayfa Açıklaması</label>
                    <input name="Description" class="form-control" value="@Model.Description" />
                </div>

                <div class="form-group">
                    <label>Sözleşme İçeriği</label>
                    <textarea name="ContentText" class="form-control" rows="12">@Model.ContentText</textarea>
                </div>

                <div class="form-group">
                    <label>PDF</label>
                    @if (!string.IsNullOrEmpty(Model.PdfUrl))
                    {
                        <div style="margin-bottom:8px;">
                            <a href="@Model.PdfUrl" target="_blank" class="btn btn-xs btn-info">
                                <i class="fa fa-file-pdf-o"></i> Mevcut PDF'i Görüntüle
                            </a>
                            <small class="text-muted"> — Yeni PDF yüklerseniz mevcut değişir.</small>
                        </div>
                    }
                    <input type="file" name="PdfFile" class="form-control" accept=".pdf" />
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /> Aktif
                    </label>
                </div>

                <a href="/Contracts/Index" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Geri
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Güncelle
                </button>
            </form>
        </div>
    </div>
</section>