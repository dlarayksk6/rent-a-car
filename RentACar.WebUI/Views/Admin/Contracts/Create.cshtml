@model RentACar.Entities.ContractDocument
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Yeni Sözleşme";
}

<section class="content-header">
    <h1><i class="fa fa-plus"></i> Yeni Sözleşme</h1>
</section>

<section class="content">
    <div class="box box-primary">
        <div class="box-body">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Başlık <span class="text-danger">*</span></label>
                    <input name="Title" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>Sayfa Açıklaması <small class="text-muted">(müşteri sayfasında başlığın altında çıkar)</small></label>
                    <input name="Description" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Sözleşme İçeriği <small class="text-muted">(direkt yazı olarak)</small></label>
                    <textarea name="ContentText" class="form-control" rows="12"
                              placeholder="Sözleşme metnini buraya yazabilirsiniz..."></textarea>
                </div>

                <div class="form-group">
                    <label>PDF Yükle <small class="text-muted">(isteğe bağlı)</small></label>
                    <input type="file" name="PdfFile" class="form-control" accept=".pdf" />
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" name="IsActive" value="true" checked /> Aktif
                    </label>
                </div>

                <a href="/Contracts/Index" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Geri
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Kaydet
                </button>
            </form>
        </div>
    </div>
</section>