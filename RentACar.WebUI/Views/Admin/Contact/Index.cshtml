@model RentACar.DTOs.Contact.ContactUpdateDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "İletişim Bilgileri Yönetimi";
}
<section class="content-header">
    <h1>İletişim Bilgilerini Düzenle</h1>
</section>
<section class="content">
    
    <div class="box box-primary">
        <form asp-action="UpdateContact" method="post">
            <input type="hidden" asp-for="SiteContactId" />  <!-- ← BU ŞART -->
            <div class="box-body">
                <div class="form-group">
                    <label>Firma Adresi</label>
                    <textarea asp-for="Address" class="form-control" rows="3" required></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Telefon</label>
                            <input asp-for="Phone" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>E-posta</label>
                            <input asp-for="Email" type="email" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label><i class="fa fa-clock-o"></i> Çalışma Saatleri</label>
                    <input asp-for="WorkingHours" class="form-control" placeholder="Örn: 7/24 Hizmet veya 09:00 - 18:00" />
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label><i class="fa fa-facebook"></i> Facebook</label>
                            <input asp-for="Facebook" class="form-control" placeholder="https://facebook.com/..." />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>WhatsApp Numarası</label>
                        <input asp-for="WhatsappNumber" class="form-control" placeholder="905xxxxxxxxx" />
                        <span asp-validation-for="WhatsappNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label><i class="fa fa-instagram"></i> Instagram</label>
                            <input asp-for="Instagram" class="form-control" placeholder="https://instagram.com/..." />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label><i class="fa fa-twitter"></i> Twitter</label>
                            <input asp-for="Twitter" class="form-control" placeholder="https://twitter.com/..." />
                        </div>
                    </div>
                </div>
            </div>
            <div class="box-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-refresh"></i> Bilgileri Güncelle
                </button>
            </div>
        </form>
    </div>
</section>