@model List<RentACar.DTOs.Car.CarListDto>
@inject IPermissionService PermissionService

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Araç Listesi";
    var userPermissions = await PermissionService.GetCurrentUserPermissionsAsync();
}

<section class="content-header">
    <h1>Araç Listesi</h1>

    @if (userPermissions.Contains("Cars.Manage") || User.IsInRole("Admin"))
    {
        <a href="/Cars/Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Yeni Araç Ekle
        </a>
    }
    else
    {
        <button class="btn btn-primary" disabled>
            <i class="fa fa-plus"></i> Yeni Araç Ekle
        </button>
    }

</section>

<section class="content">

  
    <div class="box">
        <div class="box-body">

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Resim</th>
                        <th>Marka</th>
                        <th>Model</th>
                        <th>Yıl</th>
                        <th>Renk</th>
                        <th>Plaka</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var car in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(car.ImageUrl) ? "/images/default-car.png" : car.ImageUrl)"
                                     style="width:80px;height:60px;object-fit:cover;" />
                            </td>

                            <td>@car.Brand</td>
                            <td>@car.Model</td>
                            <td>@car.Year</td>
                            <td>@car.Color</td>
                            <td>@car.PlateNumber</td>
                            <td><span class="label label-info">@car.Category</span></td>
                            <td><strong>@car.DailyPrice.ToString("N0") ₺</strong> / gün</td>

                            <td>
                                @if (car.Status)
                                {
                                    <span class="label label-success">Uygun</span>
                                }
                                else
                                {
                                    <span class="label label-danger">Rezerve</span>
                                }
                            </td>

                            <td>
                                @if (userPermissions.Contains("Cars.Manage") || User.IsInRole("Admin"))
                                {
                                    <a href="/Cars/Edit/@car.CarId" class="btn btn-sm btn-warning">
                                        <i class="fa fa-edit"></i> Düzenle
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-warning" disabled>
                                        <i class="fa fa-edit"></i> Düzenle
                                    </button>
                                }

                                @if (userPermissions.Contains("Cars.Manage") || User.IsInRole("Admin"))
                                {
                                    <form asp-action="Delete" asp-route-id="@car.CarId" method="post" style="display:inline"
                                          onsubmit="return confirm('Bu aracı silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i> Sil
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-danger" disabled>
                                        <i class="fa fa-trash"></i> Sil
                                    </button>
                                }

                            </td>

                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</section>
