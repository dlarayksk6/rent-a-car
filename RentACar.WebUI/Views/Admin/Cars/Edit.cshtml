@model RentACar.DTOs.Car.CarUpdateDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Araç Düzenle";
}
<section class="content-header">
    <h1>Araç Düzenle</h1>
</section>
<section class="content">
    <form asp-action="Edit" asp-controller="Cars" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CarId" />
        <input type="hidden" asp-for="ExistingImageUrl" />

        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Temel Bilgiler</h3>
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Marka *</label>
                            <input asp-for="Brand" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Model *</label>
                            <input asp-for="Model" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Yıl *</label>
                            <input asp-for="Year" class="form-control" type="number" min="1990" max="2030" required />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Renk *</label>
                            <input asp-for="Color" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Plaka *</label>
                            <input asp-for="PlateNumber" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Sınıf *</label>
                            <select asp-for="Category" class="form-control" required>
                                <option value="">Seç</option>
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                                <option value="E">E</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Kasa Tipi</label>
                            <select asp-for="BodyType" class="form-control">
                                <option value="">Seç</option>
                                <option value="Sedan">Sedan</option>
                                <option value="SUV">SUV</option>
                                <option value="Hatchback">Hatchback</option>
                                <option value="Coupe">Coupe</option>
                                <option value="Minivan">Minivan</option>
                                <option value="Pickup">Pickup</option>
                                <option value="Cabrio">Cabrio</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Yakıt *</label>
                            <select asp-for="FuelType" class="form-control" required>
                                <option value="">Seç</option>
                                <option value="Benzin">Benzin</option>
                                <option value="Dizel">Dizel</option>
                                <option value="LPG">LPG</option>
                                <option value="Elektrik">Elektrik</option>
                                <option value="Hibrit">Hibrit</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Vites *</label>
                            <select asp-for="Transmission" class="form-control" required>
                                <option value="">Seç</option>
                                <option value="Manuel">Manuel</option>
                                <option value="Otomatik">Otomatik</option>
                                <option value="Yarı Otomatik">Yarı Otomatik</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Çekiş</label>
                            <select asp-for="DriveType" class="form-control">
                                <option value="">Seç</option>
                                <option value="FWD">FWD (Önden)</option>
                                <option value="RWD">RWD (Arkadan)</option>
                                <option value="AWD">AWD (Tam)</option>
                                <option value="4WD">4WD</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Koltuk *</label>
                            <input asp-for="Seats" class="form-control" type="number" min="1" max="20" required />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Motor (cc)</label>
                            <input asp-for="EngineCC" class="form-control" type="number" placeholder="1600" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Beygir</label>
                            <input asp-for="HorsePower" class="form-control" type="number" placeholder="120" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Kapı</label>
                            <input asp-for="DoorCount" class="form-control" type="number" min="2" max="6" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Bagaj (L)</label>
                            <input asp-for="LuggageCapacity" class="form-control" type="number" placeholder="300" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Kilometre</label>
                            <input asp-for="Mileage" class="form-control" type="number" placeholder="50000" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Durum</label><br />
                            <input asp-for="Status" type="checkbox" /> Uygun
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="box box-success">
            <div class="box-header with-border">
                <h3 class="box-title">Fiyat & Koşullar</h3>
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Günlük Fiyat (₺) *</label>
                            <input asp-for="DailyPrice" class="form-control" type="number" step="0.01" required />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Depozito (₺)</label>
                            <input asp-for="DepositAmount" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Günlük KM Limiti</label>
                            <input asp-for="MileageLimit" class="form-control" type="number" placeholder="Boş = Sınırsız" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Ekstra KM Ücreti (₺)</label>
                            <input asp-for="ExtraKmPrice" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Min. Kiralama Günü</label>
                            <input asp-for="MinRentalDays" class="form-control" type="number" min="1" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Max. Kiralama Günü</label>
                            <input asp-for="MaxRentalDays" class="form-control" type="number" min="1" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Kredi Kartı Zorunlu</label><br />
                            <input asp-for="RequiresCreditCard" type="checkbox" /> Evet
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="box box-warning">
            <div class="box-header with-border">
                <h3 class="box-title">Sürücü Koşulları</h3>
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Min. Yaş *</label>
                            <input asp-for="MinAge" class="form-control" type="number" min="18" max="99" required />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Max. Yaş</label>
                            <input asp-for="MaxDriverAge" class="form-control" type="number" min="18" max="99" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Min. Ehliyet Yılı *</label>
                            <input asp-for="MinDriverLicenseYear" class="form-control" type="number" min="0" max="50" required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Özellikler</h3>
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="checkbox"><label><input asp-for="HasAirConditioning" type="checkbox" /> Klima</label></div>
                        <div class="checkbox"><label><input asp-for="HasBluetooth" type="checkbox" /> Bluetooth</label></div>
                        <div class="checkbox"><label><input asp-for="HasNavigation" type="checkbox" /> Navigasyon</label></div>
                    </div>
                    <div class="col-md-3">
                        <div class="checkbox"><label><input asp-for="HasBackCamera" type="checkbox" /> Geri Kamera</label></div>
                        <div class="checkbox"><label><input asp-for="HasSunroof" type="checkbox" /> Sunroof</label></div>
                        <div class="checkbox"><label><input asp-for="HasHeatedSeats" type="checkbox" /> Isıtmalı Koltuk</label></div>
                    </div>
                    <div class="col-md-3">
                        <div class="checkbox"><label><input asp-for="HasCruiseControl" type="checkbox" /> Cruise Control</label></div>
                        <div class="checkbox"><label><input asp-for="HasParkingSensor" type="checkbox" /> Park Sensörü</label></div>
                        <div class="checkbox"><label><input asp-for="HasUSBPort" type="checkbox" /> USB Port</label></div>
                    </div>
                    <div class="col-md-3">
                        <div class="checkbox"><label><input asp-for="HasChildSeat" type="checkbox" /> Çocuk Koltuğu</label></div>
                        <div class="checkbox"><label><input asp-for="IsSmokingAllowed" type="checkbox" /> Sigara İzni</label></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="box box-default">
            <div class="box-header with-border">
                <h3 class="box-title">Açıklama & Resim</h3>
            </div>
            <div class="box-body">
                <div class="form-group">
                    <label>Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
                <div class="form-group">
                    <label>Mevcut Resim</label><br />
                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                    {
                        <img src="@Model.ExistingImageUrl" style="max-height:150px; border-radius:6px; margin-bottom:10px;" />
                    }
                    else
                    {
                        <p class="text-muted">Resim yok</p>
                    }
                </div>
                <div class="form-group">
                    <label>Yeni Resim (İsteğe bağlı)</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>
            </div>
            <div class="box-footer">
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Güncelle
                </button>
                <a href="/Cars" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> İptal
                </a>
            </div>
        </div>

    </form>
</section>