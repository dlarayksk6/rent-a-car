@model List<RentACar.Entities.Campaign>
@inject IPermissionService PermissionService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Kampanyalar";
    var p = await PermissionService.GetCurrentUserPermissionsAsync();
}
<section class="content-header">
    <h1><i class="fa fa-bullhorn"></i> Kampanyalar</h1>
</section>
<section class="content">
    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Kampanya Listesi</h3>
            @if (p.Contains("Campaigns.Manage") || User.IsInRole("Admin"))
            {
                <a href="/Campaigns/Create" class="btn btn-success btn-sm pull-right">
                    <i class="fa fa-plus"></i> Yeni Kampanya
                </a>
            }
        </div>
        <div class="box-body">
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th style="width:80px;">Görsel</th>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th style="width:100px;">Eklenme</th>
                        <th style="width:80px;">Durum</th>
                        <th style="width:120px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(c.ImageUrl))
                                {
                                    <img src="@c.ImageUrl" style="width:60px; height:40px; object-fit:cover; border-radius:4px;" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><strong>@c.Title</strong></td>
                            <td>
                                <span style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                    @c.Description
                                </span>
                            </td>
                            <td><small>@c.CreatedAt.ToString("dd.MM.yyyy")</small></td>
                            <td>
                                @if (p.Contains("Campaigns.Manage") || User.IsInRole("Admin"))
                                {
                                    <button onclick="toggleStatus(@c.CampaignId, this)"
                                            class="btn btn-xs @(c.IsActive ? "btn-success" : "btn-default")">
                                        @(c.IsActive ? "Aktif" : "Pasif")
                                    </button>
                                }
                                else
                                {
                                    <span class="label @(c.IsActive ? "label-success" : "label-default")">
                                        @(c.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                }
                            </td>
                            <td>
                                @if (p.Contains("Campaigns.Manage") || User.IsInRole("Admin"))
                                {
                                    <a href="/Campaigns/Edit/@c.CampaignId" class="btn btn-warning btn-xs">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                }
                                @if (p.Contains("Campaigns.Delete") || User.IsInRole("Admin"))
                                {
                                    <form method="post" action="/Campaigns/Delete/@c.CampaignId"
                                          onsubmit="return confirm('Bu kampanyayı silmek istediğinize emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-xs">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
<script>
    function toggleStatus(id, btn) {
        $.post('/Campaigns/ToggleStatus', { id: id }, function() {
            var isActive = $(btn).hasClass('btn-success');
            $(btn).toggleClass('btn-success btn-default');
            $(btn).text(isActive ? 'Pasif' : 'Aktif');
        });
    }
</script>