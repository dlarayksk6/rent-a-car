@model RentACar.DTOs.Campaign.CampaignCreateDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Yeni Kampanya";
}

<section class="content-header">
    <h1><i class="fa fa-plus"></i> Yeni Kampanya</h1>
</section>

<section class="content">
    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Kampanya Bilgileri</h3>
        </div>
        <div class="box-body">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Başlık <span class="text-danger">*</span></label>
                    <input name="Title" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>Açıklama</label>
                    <textarea name="Description" class="form-control" rows="5"></textarea>
                </div>

                <div class="form-group">
                    <label>Görsel</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" name="IsActive" value="true" checked /> Aktif
                    </label>
                </div>

                <a href="/Campaigns/Index" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Geri
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Kaydet
                </button>
            </form>
        </div>
    </div>
</section>