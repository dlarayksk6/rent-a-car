@model List<RentACar.Entities.Brand>
@inject IPermissionService PermissionService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Marka Yönetimi";
    var p = await PermissionService.GetCurrentUserPermissionsAsync();
}
<section class="content-header">
    <h1><i class="fa fa-trademark"></i> Marka Yönetimi</h1>
    <ol class="breadcrumb">
        <li><a href="/Home"><i class="fa fa-home"></i> Ana Sayfa</a></li>
        <li class="active">Marka Yönetimi</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        @if (p.Contains("Brands.Manage") || User.IsInRole("Admin"))
        {
            <div class="col-md-4">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title"><i class="fa fa-plus"></i> Yeni Marka Ekle</h3>
                    </div>
                    <div class="box-body">
                        <form method="post" action="/Brands/Create" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label>Marka Adı <span class="text-danger">*</span></label>
                                <input type="text" name="Name" class="form-control" placeholder="Örn: Toyota" required>
                            </div>
                            <div class="form-group">
                                <label>Logo Görseli</label>
                                <input type="file" name="logoFile" class="form-control" accept="image/*" id="createLogoInput">
                                <small class="text-muted">PNG veya JPG önerilir.</small>
                            </div>
                            <div id="createPreview" style="display:none; margin-bottom:10px;">
                                <img id="createPreviewImg" src="" style="max-height:80px; border:1px solid #ddd; border-radius:6px; padding:5px;">
                            </div>
                            <div class="form-group">
                                <label>
                                    <input type="checkbox" name="IsActive" value="true" checked> Aktif
                                </label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fa fa-save"></i> Kaydet
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        <div class="@(p.Contains("Brands.Manage") || User.IsInRole("Admin") ? "col-md-8" : "col-md-12")">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-list"></i> Markalar (@Model.Count)</h3>
                </div>
                <div class="box-body no-padding">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th style="width:60px;">#</th>
                                <th style="width:80px;">Logo</th>
                                <th>Marka Adı</th>
                                <th style="width:80px;">Durum</th>
                                <th style="width:120px; text-align:right;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted" style="padding:30px;">
                                        <i class="fa fa-inbox fa-2x"></i><br>Henüz marka eklenmemiş.
                                    </td>
                                </tr>
                            }
                            @foreach (var brand in Model)
                            {
                                <tr>
                                    <td>@brand.BrandId</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(brand.LogoUrl))
                                        {
                                            <img src="@brand.LogoUrl" style="max-height:40px; max-width:60px; object-fit:contain;" onerror="this.style.display='none'">
                                        }
                                        else
                                        {
                                            <span class="label label-default"><i class="fa fa-image"></i></span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@brand.Name</strong><br>
                                        <small class="text-muted">@brand.CreatedAt.ToString("dd.MM.yyyy")</small>
                                    </td>
                                    <td>
                                        <span class="brand-status-badge label @(brand.IsActive ? "label-success" : "label-danger")"
                                              data-id="@brand.BrandId" style="cursor:pointer; font-size:12px;" title="Durumu değiştir">
                                            @(brand.IsActive ? "Aktif" : "Pasif")
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        @if (p.Contains("Brands.Manage") || User.IsInRole("Admin"))
                                        {
                                            <button class="btn btn-xs btn-warning edit-brand-btn"
                                                    data-id="@brand.BrandId" data-name="@brand.Name"
                                                    data-logo="@brand.LogoUrl" data-active="@brand.IsActive.ToString().ToLower()"
                                                    title="Düzenle">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                        }
                                        @if (p.Contains("Brands.Delete") || User.IsInRole("Admin"))
                                        {
                                            <form method="post" action="/Brands/Delete/@brand.BrandId" style="display:inline;"
                                                  onsubmit="return confirm('@brand.Name markasını silmek istediğinizden emin misiniz?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-xs btn-danger" title="Sil">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-edit"></i> Marka Düzenle</h4>
            </div>
            <form method="post" action="/Brands/Edit" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BrandId" id="editBrandId">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Marka Adı <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Mevcut Logo</label>
                        <div id="editCurrentLogo" style="margin-bottom:8px;"></div>
                        <label>Yeni Logo (opsiyonel)</label>
                        <input type="file" name="logoFile" id="editLogoInput" class="form-control" accept="image/*">
                    </div>
                    <div id="editPreview" style="display:none; margin-bottom:10px;">
                        <img id="editPreviewImg" src="" style="max-height:80px; border:1px solid #ddd; border-radius:6px; padding:5px;">
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="IsActive" id="editIsActive" value="true"> Aktif
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-save"></i> Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(".edit-brand-btn").on("click", function () {
            var id = $(this).data("id");
            var name = $(this).data("name");
            var logo = $(this).data("logo");
            var active = $(this).data("active") === "true";
            $("#editBrandId").val(id);
            $("#editName").val(name);
            $("#editIsActive").prop("checked", active);
            var logoHtml = logo
                ? '<img src="' + logo + '" style="max-height:60px; border:1px solid #ddd; border-radius:4px; padding:4px;" onerror="this.style.display=\'none\'">'
                : '<span class="text-muted">Logo yok</span>';
            $("#editCurrentLogo").html(logoHtml);
            $("#editPreview").hide();
            $("#editLogoInput").val("");
            $("#editModal").modal("show");
        });
        $("#createLogoInput").on("change", function () { previewImage(this, "#createPreviewImg", "#createPreview"); });
        $("#editLogoInput").on("change", function () { previewImage(this, "#editPreviewImg", "#editPreview"); });
        function previewImage(input, imgSelector, wrapSelector) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { $(imgSelector).attr("src", e.target.result); $(wrapSelector).show(); };
                reader.readAsDataURL(input.files[0]);
            }
        }
        $(".brand-status-badge").on("click", function () {
            var id = $(this).data("id");
            var badge = $(this);
            $.post("/AdminBrands/ToggleStatus", { id: id }, function () {
                var isActive = badge.hasClass("label-success");
                badge.toggleClass("label-success label-danger");
                badge.text(isActive ? "Pasif" : "Aktif");
            });
        });
    </script>
}